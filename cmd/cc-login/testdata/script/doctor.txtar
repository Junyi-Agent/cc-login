# Whether the test's claude counts as the claude link depends on the OS, so
# the checks of the link are in the unit tests. A login whose token file is
# gone is a problem: exit 1, with the fix.
mkdir root/.dirs/t1
cp state.json root/state.json
! exec cc-login doctor
stdout '^✓ claude: '
stdout '✗ login ci: oauth-token is gone'
stdout 'fix: cc-login remove ci, then add it again'
stderr 'cc-login: [0-9]+ problem\(s\) found'

# The token file is back; no default login is a problem, no scopes a warning.
cp token root/.dirs/t1/oauth-token
chmod 700 root/.dirs/t1
chmod 600 root/.dirs/t1/oauth-token
! exec cc-login doctor
stdout '✗ no default login'
stdout '! login ci: its token cannot read'
! stdout 'sk-ant'

! exec cc-login doctor extra
stderr 'unknown command|accepts no arguments'

-- state.json --
{
  "version": 1,
  "logins": {
    "t1": {"name": "ci", "kind": "token", "created_at": "2026-11-01T00:00:00Z"}
  }
}
-- token --
sk-ant-oat01-fake-token
