# A wrong command line: the reason, and where the help is.
! exec cc-login nope
stderr 'unknown command "nope"'
stderr 'Run ''cc-login --help'' for usage.'

! exec cc-login lsit
stderr 'did you mean list\?'

! exec cc-login use
stderr 'accepts 1 arg\(s\), received 0'
stderr 'Run ''cc-login use --help'' for usage.'

! exec cc-login add x --sign-in --api-key
stderr 'none of the others can be'
stderr 'Run ''cc-login add --help'' for usage.'

# claude's options without --: where they go.
! exec cc-login run -p hi
stderr 'unknown shorthand flag'
stderr 'options for claude go after --: cc-login run \[NAME\] -- OPTS'
! exec cc-login add x --sign-in --email me@example.com
stderr 'go after --sign-in --'
! exec cc-login renew x --email me@example.com
stderr 'cc-login renew NAME -- OPTS'
! exec cc-login list --nope
! stderr 'go after'

# No logins: run says to add one.
! exec cc-login run
stderr 'no logins yet; add one with: cc-login add NAME'

# The arguments are not echoed: a token pasted in the wrong place stays out
# of the terminal.
! exec cc-login add work sk-ant-oat01-pasted
! stderr 'sk-ant'


exec cc-login --help
stdout 'Available Commands:'
stdout 'adopt'

exec cc-login completion zsh
stdout '#compdef cc-login'

# The version, and the debug log on stderr.
exec cc-login version
stdout '^cc-login .* \(go1\.'
# The claude it runs, and the claude link. Whether the claude testscript
# puts first in PATH is the same file as cc-login depends on the system.
stdout '^claude: .*claude$'
stdout '^claude link: '
exec cc-login --version
stdout '^cc-login '

mkdir root/.dirs/a1
cp state.json root/state.json
exec cc-login list --verbose
stderr 'level=DEBUG msg=list .*logins=1'
stderr 'msg=probe login=work .*status=signed-out'
env CC_LOGIN_DEBUG=1
exec cc-login list
stderr 'msg=probe'

-- state.json --
{"version": 1, "logins": {"a1": {"name": "work", "kind": "sign-in", "created_at": "2026-11-01T00:00:00Z"}}}
