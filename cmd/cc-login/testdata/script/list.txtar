# No state.json and no old layout: no logins yet.
exec cc-login
stdout 'No logins yet'
! stderr .

# list reads state.json; the fake claude says work is signed in.
mkdir root/.dirs/a1 root/.dirs/b2
cp state.json root/state.json
cp status.json root/.dirs/a1/fake-status.json

exec cc-login list
stdout '▸ work +me@example.com +team .* ● signed in'
stdout '  home +- .* ○ signed out'
stdout 'Sign in again with: cc-login renew home'
! stderr .

# Empty fields are empty between the tabs.
exec cc-login list --format tsv
stdout '^home\tfalse\tsign-in\tsigned-out\t\t\t\t\t$'
stdout '^work\ttrue\tsign-in\tsigned-in\tme@example.com\tteam\t\t\t$'

exec cc-login list --format '{{.Name}}:{{.Default}}'
stdout '^home:false\nwork:true$'

exec cc-login list --json
stdout '"name": "work"'
stdout '"status": "signed-in"'

! exec cc-login list --json --format tsv
stderr 'none of the others can be'

-- state.json --
{
  "version": 1,
  "default": "a1",
  "logins": {
    "a1": {"name": "work", "kind": "sign-in", "account": "me@example.com", "plan": "team", "created_at": "2026-11-01T00:00:00Z"},
    "b2": {"name": "home", "kind": "sign-in", "created_at": "2026-11-01T00:00:00Z"}
  }
}
-- status.json --
{"loggedIn": true, "email": "me@example.com"}
