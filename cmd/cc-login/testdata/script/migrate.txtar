# The zsh layout: work links to .dirs/a1, ci to .dirs/t1 (a token login).
mkdir root/.dirs/a1 root/.dirs/t1 root/.dirs/p1
symlink root/work -> .dirs/a1
symlink root/ci -> .dirs/t1
cp work.json root/work.json
cp ci.json root/ci.json
cp token root/.dirs/t1/oauth-token
cp current root/current
cp pending root/.pending
cp creds root/.dirs/p1/.credentials.json

! exec cc-login list
stderr 'convert them with: cc-login migrate'

exec cc-login migrate
stdout 'Migrated 3 logins \(default: work\)'
stderr 'is now login default'

# The credentials stay where they were; the old links and records moved.
exists root/.dirs/t1/oauth-token
exists root/state.json
! exists root/work
! exists root/current
exec cc-login list --format '{{.Name}} {{.Kind}} {{.Default}}'
cmp stdout want

exec cc-login migrate
stdout 'Nothing to do'

-- work.json --
{"email": "me@example.com", "subscriptionType": "team", "orgId": "o1"}
-- ci.json --
{"authMethod": "oauth_token", "loginExpiresAt": "2027-11-01T00:00:00Z", "tokenSavedAt": "2026-11-01T00:00:00Z"}
-- token --
sk-ant-oat01-fake
-- current --
work
-- pending --
p1
-- creds --
{}
-- want --
ci token false
default sign-in false
work sign-in true
